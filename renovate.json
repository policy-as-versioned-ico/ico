{
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/cut-release\\.yml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/\\S+"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "Renovate does not update the sha256 checked beside this download. Before this pull request merges, replace that sha256 by hand, and any other mention of the old version in the file."
      ]
    }
  ]
}
