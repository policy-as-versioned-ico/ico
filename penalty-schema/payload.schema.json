{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://policy-as-versioned.dev/schema/ico-penalty-schema-payload.json",
  "title": "ico penalty-schema feed payload, major 3",
  "description": "The payload half of the one feed envelope (ADR-0019) for ico's penalty-schema feed, major 3. Major 2's regimes payload plus control_weights: per regime, per violation type, the (source, id) catalogue controls the regime turns on and the share of the regime's exposure each carries (ticket 15 Answer 1). Weights sum to 1.0 within a violation type, so a hole partitions the regime exposure and never adds to it. The control ids key on the controls parent this repo pins in party.yaml inherits[]; a catalogue bump cannot orphan them.",
  "type": "object",
  "required": [
    "note",
    "regimes",
    "control_weights"
  ],
  "additionalProperties": false,
  "properties": {
    "note": {
      "type": "string",
      "minLength": 1
    },
    "changelog": {
      "type": "string",
      "minLength": 1
    },
    "regimes": {
      "type": "object",
      "minProperties": 1,
      "description": "Keyed by regime name, e.g. uk-gdpr. The name an adopter declares in its obligations.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "authority",
          "statute",
          "currency",
          "violation_types"
        ],
        "additionalProperties": false,
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "statute": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "violation_types": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "description",
                "formula"
              ],
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "formula": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "description": "One of pct_of_global_turnover, per_month_escalating, per_violation_tier, pct_of_relevant_revenue_plus_discretion. Each carries its own rate, cap or band fields; the converter beside this feed reads them.",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "real_examples_gbp": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "real_examples_usd": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "control_weights": {
      "type": "object",
      "minProperties": 1,
      "description": "Keyed by regime name, then by violation type name. Both keys must name an entry that exists under regimes.",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "description": "Weights within one violation type sum to 1.0 (tolerance 1e-9).",
          "items": {
            "type": "object",
            "required": [
              "source",
              "id",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "The controls parent that defines the id, e.g. nist. Half of the (source, id) key."
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "A bare catalogue control id as it appears on the wire, e.g. sc-28."
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
